<?xml version="1.0" encoding="utf-8"?>
<!-- Marque centrée (carte arrondie) — même esprit que le splash Flutter -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="88dp"
        android:height="88dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/faso_splash_mark_fill" />
            <stroke
                android:width="1.5dp"
                android:color="@color/faso_splash_mark_stroke" />
        </shape>
    </item>
</layer-list>
